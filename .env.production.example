# Template PRODUKSI (SEC-014). Salin ke .env di server, isi nilai rahasia, jangan di-commit.
# Aplikasi menolak melayani request bila APP_DEBUG=true, BARA_FILE_SCANNER=none, atau cookie
# sesi tidak Secure (AppServiceProvider::guardProductionConfiguration).
APP_NAME=BARA
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://bara.example.go.id

APP_LOCALE=id
APP_FALLBACK_LOCALE=en

HASH_DRIVER=argon2id

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

# Pengguna DB aplikasi BUKAN pemilik tabel (ADR 0011, docs/13): hanya INSERT/SELECT pada audit_logs.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=bara
DB_USERNAME=bara_app
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=null
BARA_PRIVILEGED_IDLE_MINUTES=30

# IP reverse proxy / load balancer yang menerminasi TLS (pisahkan dengan koma).
BARA_TRUSTED_PROXIES=10.0.0.10

QUEUE_CONNECTION=redis
CACHE_STORE=redis
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@example.go.id"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

BARA_PEMDA_CODE=
BARA_PEMDA_NAME=
BARA_REGION_CODE=
BARA_TIMEZONE=Asia/Makassar
BARA_ADMIN_EMAIL=
BARA_ADMIN_PASSWORD=

BARA_FILE_SCANNER=clamav
BARA_CLAMAV_SOCKET=unix:///var/run/clamav/clamd.ctl
BARA_CONCURRENT_INDEX=true
