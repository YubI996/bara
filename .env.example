# Template PENGEMBANGAN lokal. Untuk server produksi pakai .env.production.example.
APP_NAME=BARA
APP_ENV=local
APP_KEY=
APP_DEBUG=true

APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

HASH_DRIVER=argon2id
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=bara
DB_USERNAME=bara
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Produksi: wajib true (default otomatis true bila APP_ENV=production).
# SESSION_SECURE_COOKIE=true
# Idle timeout (menit) untuk admin/app_admin/clearance tinggi (docs/05 §6).
BARA_PRIVILEGED_IDLE_MINUTES=30
# IP reverse proxy tepercaya (produksi), mis. 10.0.0.10 atau * di balik load balancer terkelola.
BARA_TRUSTED_PROXIES=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Identitas instance Pemda (config/bara.php)
BARA_PEMDA_CODE=pemda
BARA_PEMDA_NAME="Pemerintah Daerah"
BARA_REGION_CODE=
BARA_TIMEZONE=Asia/Makassar
BARA_ADMIN_EMAIL=admin@example.test
BARA_ADMIN_PASSWORD=
# Pemindai lampiran: none (dev) | clamav (produksi; default otomatis clamav bila APP_ENV=production)
BARA_FILE_SCANNER=none
BARA_CLAMAV_SOCKET=tcp://127.0.0.1:3310
